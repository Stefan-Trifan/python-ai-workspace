   "source": [
    "X = np.array([1,2,3,4,5])\n",
    "y = np.array([2,4,5,4,5])\n",
    "\n",
    "# Construcción de la matriz de diseño (X y columna de 1s para el intercepto)\n",
    "X1 = np.column_stack((np.ones(len(X)), X))\n",
    "\n",
    "# Ecuación normal\n",
    "betas = np.linalg.inv(X1.T @ X1) @ X1.T @ y\n",
    "print(betas)"
   ]
  }
 ],
